MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 764324424}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf12a632728c9355bb716f3908c0cf42, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  nomeDaFase: "Barra de Laguna \xB7 1839"
  tempoLimite: 270
  sobrevivencia: 0
  forte: {fileID: 391846062}
  geradorDeOndas: {fileID: 527628730}
  painelFim: {fileID: 1909411589}
  textoFim: {fileID: 1519811271}
  botaoProximaFase: {fileID: 1998625455}
  velocidades:
  - 1
  - 2
  - 4
  caixaDeDialogo: {fileID: 589353897}
  falasDoInicio:
  - personagem: {fileID: 0}
    texto: Em Laguna...
  - personagem: {fileID: 0}
    texto: "Tiros de canh\xF5es navais e terrestres podem ser ouvidos por todos os
      lados."
  - personagem: {fileID: 11400000, guid: 44e339222ff4419e58d857fe7a9032a1, type: 2}
    texto: "Tch\xEA, mas que barbaridade!"
  - personagem: {fileID: 11400000, guid: 330263a32b4112bdf94fa1cc97ae6e8d, type: 2}
    texto: "Venham logo! Precisamos de refor\xE7os de imediato."
  - personagem: {fileID: 11400000, guid: 66bf9ef144d7bcb8eb492876f75f8533, type: 2}
    texto: "A batalha j\xE1 comecou!"
  falasDoFim:
  - personagem: {fileID: 11400000, guid: 330263a32b4112bdf94fa1cc97ae6e8d, type: 2}
    texto: 'Mas que tri de bom, guri. Conquistamos Laguna! '
  - personagem: {fileID: 11400000, guid: 44e339222ff4419e58d857fe7a9032a1, type: 2}
    texto: "\xC9 meu cupincha X\xEDru, Netto e Gon\xE7alves fizeram bem em falar
      de voc\xEA."
  - personagem: {fileID: 11400000, guid: 44e339222ff4419e58d857fe7a9032a1, type: 2}
    texto: "Continue em frente at\xE9 Campos Gerais! Nos encontraremos de novo na
      capital do imp\xE9rio!"
